{
  "name": "statarb-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local dashboard for statarb-agent. Displays stored results; computes nothing.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:types": "node scripts/gen-types.mjs",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "katex": "0.19.1",
    "lucide-react": "1.80.0",
    "motion": "14.14.0",
    "plotly.js-dist-min": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.10",
    "@types/plotly.js": "3.0.15",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
